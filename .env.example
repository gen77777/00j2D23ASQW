# Copy to .env.local for development, or provide via your deployment platform / docker-compose
# env_file in production. Never commit the real values.

# HMAC key used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# salt:hash pair for the single admin password (scrypt, hex-encoded). Generate with:
#   node scripts/hash-password.mjs "your-password"
ADMIN_PASSWORD_HASH="123"

# Production domain, no trailing slash — used for metadataBase, canonical URLs, sitemap.xml, and
# robots.txt. Falls back to http://localhost:3000 in dev if unset.
NEXT_PUBLIC_SITE_URL=
